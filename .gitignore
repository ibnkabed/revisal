# النسخة الاحتياطية الواحدة لا تدخل Git (عقد حارس المشروع)
/backups/
# الأسرار لا تُرفع أبدًا
.env
*.key
# ما يُعاد توليده
__pycache__/
*.pyc
.venv/
node_modules/
# بناء Xcode يُعاد توليده
ios/build/
ios/*.xcodeproj/
.DS_Store
Thumbs.db
# ملفات PDF المصدر للبنكين لا تُرفع (حقوقها لأصحابها)، ويُرفع البنك المستخرج منها
/المصادر/
# قراءات صفحات PDF المحفوظة لأداة البنك (تُعاد بكلفة)
/.bank-cache/
